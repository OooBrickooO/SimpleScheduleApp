function openLoading() {
    $('body').append('<div class="loading"><iconpark-icon fill="currentColor" name="jiazai"></iconpark-icon><br/>加载中...</div>');
}
function closeLoading() {
    $('.loading').hide()
}
function navChoose(element) {
  let obj = $('.nav-one .nav-two > ul .nav-three[data-src="' + element.data('src') + '"]');
  // // 判断三级菜单是否打开
  // if (obj.hasClass('choose')) {
  //   // 如果已经打开则return
  //   $('#mainIframe').attr('src', obj.data('src'));
  //   return;
  // }

  // 清除所有三级选中状态
  $('.nav-three').removeClass('choose');
  $('.nav-three').find('iconpark-icon').remove();
  // 给当前选中加上星标
  if (obj.find('iconpark-icon').length == 0) {
    obj.append('<iconpark-icon name="wujiaoxing"></iconpark-icon>');
  }
  // 添加选中状态
  obj.addClass('choose');

  if (obj.parents('.nav-one > ul').css('display') == 'none') {
    // 清除所有一级选中状态
    $('.nav-one').removeClass('choose');
    $('.nav-one > ul').slideUp();
    // 所有一级菜单图标切换为未选择状态
    for (var item of Array.from($('.nav-one img'))) {
      $(item).attr('src', '../css/images/lzjtdx/' + $(item).data('src') + '.png');
    }
    // 给当前一级添加选中状态
    obj.parents('.nav-one').addClass('choose');
    obj.parents('.nav-one > ul').slideDown();
    // 切换图标
    let img = obj.parents('.nav-one').find('img');
    img.attr('src', '../css/images/lzjtdx/' + img.data('isrc') + '.png');
  }

  $('.index-tab .tab-content ul li').removeClass('star');
  $('.index-tab .tab-content ul li').find('iconpark-icon[name="gerenzhongxin"]').remove();
  $('.index-tab .tab-content ul li[data-src="' + element.data('src') + '"]').addClass('star');
  $('.index-tab .tab-content ul li[data-src="' + element.data('src') + '"]').prepend(
      '<iconpark-icon name="gerenzhongxin"></iconpark-icon>'
  );
  $('#mainIframe').attr('src', obj.data('src'));
  $('.cygn-content').hide();

  // 个人中心移除样式
  if ($('.index-tab .personCenter').hasClass('star')) {
    $('.index-tab .personCenter').removeClass('star');
    $('.index-tab .personCenter').find('iconpark-icon[name="gerenzhongxin"]').remove();
  }

  if ($('.tab-content-move li[data-src="' + obj.data('src') + '"]').length == 0) {
    // 清除所有tab的选中状态
    $('.index-tab .tab-content ul li').removeClass('star');
    // tab-content-move添加该菜单
    $('.tab-content-move').append(
        '<li class="star" data-src="' +
        obj.data('src') +
        '">' +
        '<iconpark-icon name="gerenzhongxin"></iconpark-icon>' +
        '<span>' +
        obj.find('div').text() +
        '</span>' +
        '<iconpark-icon fill="currentColor" class="close" name="guanbidangqian"></iconpark-icon>' +
        '</li>'
    );
  }
}

function personCenterClick(e) {
  $('.index-tab .tab-content ul li').removeClass('star');
  $('.index-tab .tab-content ul li').find('iconpark-icon[name="gerenzhongxin"]').remove();
  if ($('.index-tab .personCenter iconpark-icon[name="gerenzhongxin"]').length === 0) {
    $('.index-tab .personCenter').prepend('<iconpark-icon name="gerenzhongxin"></iconpark-icon>');
  }
  $('.index-tab .personCenter').addClass('star');
  $('#mainIframe').attr('src', $('.index-tab .personCenter').data('src'));
  $('.cygn-content').show();

  // 清除所有三级选中状态
  $('.nav-three').removeClass('choose');
  $('.nav-three').find('iconpark-icon').remove();

  // 防止冒泡
  e.stopPropagation();
}
