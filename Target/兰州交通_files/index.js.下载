$(function () {
  // 标记当前tab
  let currentTab = null;

  let liWidth = $('.cygn-content .cygn-add')[0].getBoundingClientRect().width;
  $('.cygn-content .cygn-content-move li').css('width', liWidth + 'px');

  // 右键菜单显示隐藏
  $('.index-tab .tab-content').bind('contextmenu', 'li', function (e) {
    // 阻止右键默认事件
    e.preventDefault ? e.preventDefault() : (e.returnValue = false);
    // 获取当前选中的tab
    currentTab = $(e.target).parent('li')[0];
    // 获取当前选中的tab的位置
    if(!currentTab){
      return;
    }
    let left = currentTab.getBoundingClientRect().left;
    // 显示并定位右键菜单
    $('.contextmenu').css('left', left + 'px');
    $('.contextmenu').show();
    // 绑定点击其他地方右键菜单隐藏事件
    $(document).on('mouseup', clearContextmenu);
    $('#mainIframe').contents().on('mouseup', clearContextmenu);
  });

  $('#search').on('input', e => {
    let keyWords = $('#search').val();
  if (keyWords === '') {
    $('.searchMenu-list').hide();
  } else {
    $('.searchMenu-list').show();
  }
// 绑定点击其他地方右键菜单隐藏事件
  $(document).on('mouseup', clearContextmenu);
  $('#mainIframe').contents().on('mouseup', clearContextmenu);
});


  // 右键菜单隐藏事件
  function clearContextmenu() {
    $('.contextmenu').hide();
    $('.eduTime-dialog').hide();
    $('.searchMenu-list').hide();
    document.onmouseup = null;
    $('#mainIframe').contents().onmousedown = null;
  }

  // 右键菜单
  $('.closeLeft').on('mousedown', e => {
    $(currentTab).prevAll().remove();
    // 防止冒泡
    e.stopPropagation();
  });

  $('.closeRight').on('mousedown', e => {
    $(currentTab).nextAll().remove();
    // 防止冒泡
    e.stopPropagation();
  });

  $('.closeCurrent').on('mousedown', e => {
    if ($(currentTab).hasClass('star')) {
       let obj = $(currentTab).prev();
       navChoose(obj);
    }
    $(currentTab).remove();
    // 防止冒泡
    e.stopPropagation();
  });

  $('.closeOther').on('mousedown', e => {
    $(currentTab).siblings().remove();
    // 防止冒泡
    e.stopPropagation();
  });

  $('.closeAll').on('mousedown', e => {
    $('.index-tab .tab-content ul').empty();
    personCenterClick(e);

  // 防止冒泡
  e.stopPropagation();
});

  // tab关闭
  $('.index-tab').on('mousedown', '.close', e => {
    if ($(e.currentTarget).parent().index() === 0) {
        personCenterClick(e);
    } else {
      if ($(e.currentTarget).parent().hasClass('star')) {
        let obj = $(e.currentTarget).parent().prev();
        navChoose(obj);
      }
    }
  $(e.currentTarget).parent().remove();
  e.stopPropagation();
});

  // tab选中
  $('.index-tab .tab-content ul ').on('click', 'li', e => {
    navChoose($(e.currentTarget));

    // 防止冒泡
    e.stopPropagation();
  });
  $('.index-tab .personCenter').on('click', personCenterClick);

  let tagMove = $('.tab-content-move');
  $('.tab-left').on('click', e => {
    let tagMoveLeft = parseInt(tagMove.css('left'));
    if (tagMoveLeft >= 0) {
      tagMove.css('left', '0px');
      return;
    }
    tagMove.css('left', tagMoveLeft + 200 + 'px');
  });
  $('.tab-right').on('click', e => {
    let tagWidth = $('.tab-content-move').width() - $('.tab-content').width();
    let tagMoveLeft = parseInt(tagMove.css('left'));
    if (Math.abs(tagMoveLeft) > tagWidth) {
      tagMove.css('left', '-' + tagMoveLeft + 'px');
      return;
    }
    tagMove.css('left', tagMoveLeft - 200 + 'px');
  });

  // nav
  // 一级菜单点击
  $('.nav-one').on('click', e => {
    // 点击的是当前已展开的一级菜单
    if ($(e.currentTarget).hasClass('choose')) {
      // 收缩所有二三级菜单
      $('.nav-one > ul').slideUp(400);
      // 去除一级菜单选中样式
      $('.nav-one').removeClass('choose');
      // 切换图标
      let img = $(e.currentTarget).find('img');
      img.attr('src', '../css/images/lzjtdx/' + img.data('src') + '.png');
      return;
    }

    // 收缩所有二三级菜单
    $('.nav-one > ul').slideUp(400);
    // 所有一级菜单图标切换为未选择状态
    for (var item of Array.from($('.nav-one img'))) {
      $(item).attr('src', '../css/images/lzjtdx/' + $(item).data('src') + '.png');
    }
    // 去除一级菜单选中样式
    $('.nav-one').removeClass('choose');
    // 切换当前一级菜单选中状态
    $(e.currentTarget).toggleClass('choose');
    // 切换图标
    let img = $(e.currentTarget).find('img');
    img.attr('src', '../css/images/lzjtdx/' + img.data('isrc') + '.png');
    // 展开二三级菜单
    $(e.currentTarget).find('ul').slideDown(400);
    // 防止冒泡
    e.stopPropagation();
  });

  // 二级菜单点击
  $('.nav-one > ul li').on('click', e => {
    // 切换二级菜单箭头方向
    $(e.currentTarget).toggleClass('expand');
    // 切换三级菜单是否展开收缩
    $(e.currentTarget).find('ul').slideToggle(400);
    // 防止冒泡
    e.stopPropagation();
  });

  // 三级菜单选中
  $('.nav-three').on('click', e => {
    // 点击已经选中的三级菜单
    navChoose($(e.currentTarget));
    $('.cygn-content').hide();
  });

  $('#bell').on('click', e => {
    navChoose($('#bell'));
  });

  // 容器宽度
  let left = $('.cygn-content')[0].getBoundingClientRect().left;
  // 弹窗宽度
  let width = $('.cygn-add-dialog').width();
  $('.cygn-add').on('click', e => {
    //清空替换属性值
    $("#fucecode_sid").val("");

    $('.dialog-header:first-child').show();
    $('.dialog-header:nth-child(2)').removeClass('dialog-content');

    // 替换位置
  let position = $(e.currentTarget)[0].getBoundingClientRect();
    if (width > $(document).width() - position.right) {
      $('.cygn-add-dialog').css('left', 'auto');
      $('.cygn-add-dialog').css('right', $(document).width() - position.right - 12 + 'px');
      $('.cygn-add-dialog').removeClass('left');
    } else {
      $('.cygn-add-dialog').css('left', position.left - left + 'px');
      $('.cygn-add-dialog').css('right', 'auto');
      $('.cygn-add-dialog').addClass('left');
    }
    $('.cygn-add-dialog').show();
    // 绑定点击其他地方右键菜单隐藏事件
    // 绑定点击其他地方右键菜单隐藏事件
    $(document).on('mouseup', clearCygnAddDialog);
    $('#mainIframe').contents().on('mouseup', clearCygnAddDialog);
});

  // 右键菜单隐藏事件
  function clearCygnAddDialog(e) {
    let obj =
      $(e.target).hasClass('cygn-add-dialog') || $(e.target).parents('.cygn-add-dialog').hasClass('cygn-add-dialog');
    if (!obj) {
      $('.cygn-add-dialog').hide();
      document.onmouseup = null;
      $('#mainIframe').contents().onmousedown = null;
    }
  }

  $('.cygn-add-dialog ul li').on('click', e => {
    // debugger
    let obj = $(e.currentTarget);
    obj.find('iconpark-icon').toggleClass('ihover');
    if (obj.find('iconpark-icon[name=fuxuankuangxuanzhongbai]').hasClass('ihover')) {
      obj.find('input').removeAttr('checked', 'checked');
      obj.find('iconpark-icon').remove();
      obj.prepend('<iconpark-icon name="weixuanzhong"></iconpark-icon>');
      return;
    } else {
      obj.find('input').attr('checked', 'checked');
      obj.find('iconpark-icon').attr('name', 'fuxuankuangxuanzhonglan');
      obj.find('iconpark-icon[name=weixuanzhong]').remove();
      obj.prepend('<iconpark-icon class="hover" name="fuxuankuangxuanzhongbai"></iconpark-icon>');
    }
  });
  $('body').on('click', '.bjyd-dialog .close', e => {
      $('.bjyd-dialog').hide();
     $('.mask').remove();
  });
});
function change() {
  let obj = $(window.event.target);
  obj.parent().addClass('choose');
}
function openDialog(width, height, title, src) {
  $('body').append('<div class="mask"></div>');
  $('.bjyd-dialog').show();
  $('.bjyd-dialog').css('width', width + 'px');
  $('.bjyd-dialog').css('height', height + 'px');
  $('.bjyd-dialog-header>div').text(title);
  $('.bjyd-dialog iframe').attr('src', src);
}


